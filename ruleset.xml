<?xml version="1.0"?>
<ruleset name="PHPMD rule set for lasselehtinen/laravel-conventions-checker"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0
                     http://pmd.sf.net/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="
                     http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>
        PHPMD rule set for lasselehtinen/laravel-conventions-checker
    </description>

    <!-- Import the entire unused code rule set -->
    <rule ref="rulesets/unusedcode.xml">
        <exclude name="UnusedLocalVariable"/>
        <exclude name="UnusedFormalParameter"/>
    </rule>
    <rule ref="rulesets/codesize.xml" />
    <rule ref="rulesets/cleancode.xml">
        <!-- Facades and Eloquent static calls are idiomatic Laravel -->
        <exclude name="StaticAccess"/>
        <!-- Common and readable in Laravel code, e.g. early returns are preferred but not enforced -->
        <exclude name="ElseExpression"/>
        <!-- Laravel's own APIs use boolean flags extensively, e.g. $request->boolean('x', false) -->
        <exclude name="BooleanArgumentFlag"/>
    </rule>
    <rule ref="rulesets/naming.xml">
        <exclude name="ShortVariable"/>
    </rule>
</ruleset>
